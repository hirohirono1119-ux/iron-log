# このファイルを .env にコピーして値を埋める(.env は git 管理外)
# APIキーは Phase 3 以降で使用。キーには出金権限を付けないこと(docs/DESIGN.md §8.1)

# 通知メール(Phase 1 の日次サマリで使用)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=

# 取引所APIキー(Phase 3 まで空でよい)
BITFLYER_API_KEY=
BITFLYER_API_SECRET=
BINANCE_JP_API_KEY=
BINANCE_JP_API_SECRET=
GMO_API_KEY=
GMO_API_SECRET=
BITBANK_API_KEY=
BITBANK_API_SECRET=
